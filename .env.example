# ==============================================================================
# XCLOUD Multi-Tenant ISP & Hotspot Controller - Production Environment Variables
# Optimized for Google Cloud Run Deployment
# ==============================================================================

# --- Server & Dynamic URLs (Supports Custom Domains e.g. app.xcloud.co.tz) ---
PORT=8080
NODE_ENV=production
PUBLIC_APP_URL=https://app.xcloud.co.tz
API_URL=https://app.xcloud.co.tz/api
WEBHOOK_URL=https://app.xcloud.co.tz/api/payments/webhook
APP_URL=https://app.xcloud.co.tz

# --- Security & JWT Authentication ---
JWT_SECRET=xcloud-production-jwt-secret-replace-with-64-byte-secure-hex-string
JWT_EXPIRES_IN=24h
CORS_ORIGINS=https://app.xcloud.co.tz,https://xcloud.co.tz

# --- PostgreSQL Production Database (Cloud SQL or Standard Postgres) ---
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_secure_db_password
PGDATABASE=xcloud_production
# Or full connection URI:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/xcloud_production
# Cloud SQL Auth Proxy Unix Socket:
# SQL_HOST=/cloudsql/YOUR_GCP_PROJECT:europe-west2:xcloud-pg-db

# --- Google Secret Manager Integration (Server-side Only) ---
GCP_PROJECT_ID=your-gcp-project-id
USE_SECRET_MANAGER=false

# --- FreeRADIUS RFC-Compliant AAA Engine ---
RADIUS_SECRET=Testing123-XCLOUD-RADIUS-Secret
RADIUS_DEFAULT_REALM=xcloud.local
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813

# --- Central WireGuard VPN Gateway ---
WIREGUARD_SERVER_ENDPOINT=vpn.xcloud.co.tz:51820
WIREGUARD_SERVER_PUBLIC_KEY=ServerWireGuardPublicKeyBase64=
WIREGUARD_SERVER_SUBNET=10.88.0.0/24

# --- TP-Link Omada Controller Integration Defaults ---
OMADA_DEFAULT_URL=https://omada.xcloud.co.tz:8043
OMADA_DEFAULT_OPERATOR=admin
OMADA_DEFAULT_PASSWORD=your_secure_omada_password

# --- Tanzania Mobile Money Payment Gateways ---
# Vodacom Tanzania M-Pesa OpenAPI (Daraja)
MPESA_API_KEY=your_mpesa_production_api_key
MPESA_PUBLIC_KEY=your_mpesa_public_key
MPESA_ORIGIN=developer.vodacom.co.tz
MPESA_SERVICE_PROVIDER_CODE=000000
MPESA_INITIATOR_IDENTIFIER=your_initiator
MPESA_SECURITY_CREDENTIAL=your_security_credential

# Tigo Pesa (Mixx by Yas)
TIGO_PESA_API_KEY=your_tigo_key
TIGO_PESA_SECRET=your_tigo_secret
TIGO_PESA_ACCOUNT_NUMBER=255710000000

# Airtel Money Tanzania
AIRTEL_MONEY_CLIENT_ID=your_airtel_client_id
AIRTEL_MONEY_CLIENT_SECRET=your_airtel_client_secret

# AzamPay Unified National Checkout Aggregator
AZAMPAY_APP_NAME=XCloudISP
AZAMPAY_CLIENT_ID=your_azampay_client_id
AZAMPAY_CLIENT_SECRET=your_azampay_client_secret
AZAMPAY_WEBHOOK_SECRET=your_webhook_signature_secret
